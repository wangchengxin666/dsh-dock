# --- 1. 访问端口与公开地址（仅当走自定义域名或外层反代时需要修改） ----------
HOST_PORT=8080
# SITE_ADDRESS=ai.example.com
# DSH_PUBLIC_URL=https://ai.example.com/dsh/
# PUBLIC_SCHEME=http

# --- 2. 网关认证（none | basic | forward_auth） -------------------------------
CADDY_AUTH_MODE=basic
CADDY_AUTH_USER=admin
CADDY_AUTH_PASSWORD=change-me-strong-password
# CADDY_AUTH_PASSWORD_HASH=

# --- 3. 可选 OAuth2/OIDC 单点登录（需配合 docker compose --profile oauth up）---
# CADDY_AUTH_MODE=forward_auth
# OAUTH2_PROXY_PROVIDER=github
# OAUTH2_PROXY_CLIENT_ID=
# OAUTH2_PROXY_CLIENT_SECRET=
# OAUTH2_PROXY_COOKIE_SECRET=
# OAUTH2_PROXY_REDIRECT_URL=https://ai.example.com/oauth2/callback
