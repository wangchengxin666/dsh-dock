HOST_PORT=8080
# Compose container and volume prefix.
CONTAINER_NAME=dsh-sandbox
# Compose image repository and tag.
DSH_IMAGE_REPO=dsh-sandbox
DSH_IMAGE_TAG=latest

# --- Optional build-time overrides (for internal networks / mirrors) --------
# DOCKER_REGISTRY=docker.io/library
# APT_MIRROR=deb.debian.org
# NPM_REGISTRY=
# INSTALL_DOTNET=false

# Browser-facing URL for the sandbox DSH Web UI.
DSH_PUBLIC_URL=http://localhost:8080/dsh/

# --- Authentication mode: 'oidc' or 'none' ----------------------------------
# Set AUTH_MODE=none for local standalone use (protected by DSH launch token).
# Set AUTH_MODE=oidc when behind an OIDC identity provider (Keycloak, Auth0, etc.).
AUTH_MODE=none

# --- OIDC settings (required only when AUTH_MODE=oidc) ----------------------
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://idp.example.com/realms/main
OAUTH2_PROXY_CLIENT_ID=dsh-sandbox
OAUTH2_PROXY_CLIENT_SECRET=replace-with-the-client-secret

# Must match the browser-facing host and the IdP's registered Redirect URI.
OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=localhost:8080,localhost

# 32 characters (16/24/32 allowed). e.g.
#   head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-32
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-random-characters
OAUTH2_PROXY_COOKIE_SECURE=false
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=168h

OAUTH2_PROXY_SCOPE=openid profile email
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=email
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
OAUTH2_PROXY_PORT=4180
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_SKIP_CLAIMS_FROM_PROFILE_URL=true
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1/32
OAUTH2_PROXY_PASS_USER_HEADERS=false
OAUTH2_PROXY_SILENCE_PING_LOGGING=true
# Some OIDC providers report email_verified=false:
# OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=true

# Exact email allowlist for DSH when AUTH_MODE=oidc, comma-separated.
DSH_ALLOWED_EMAILS=you@example.com

# --- Optional default LLM & Plugin settings injected at startup -------------
# DSH_DEFAULT_LLM_PROVIDER=openai-compatible
# DSH_DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
# DSH_DEFAULT_LLM_MODEL=deepseek-chat
# DSH_DEFAULT_LLM_API_KEY=
# DSH_PLUGIN_INDEX_URL=http://host.docker.internal:9000/plugins/index.json
# DSH_AUTO_INSTALL_PLUGINS=

# danger-full-access: the container itself is the sandbox.
DSH_PERMISSION_MODE=danger-full-access

TZ=UTC
