#!/usr/bin/env bash
# Run the user-level supervisord as workspace. The container-level supervisord keeps
# this process alive across DSH restarts; the user-level instance owns the
# programs under ~/.dsh-sandbox/services/conf.d.
set -euo pipefail

: "${HOME:=/home/workspace}"
config="${HOME}/.dsh-sandbox/services/supervisord.conf"

if [ -r /opt/toolchain/env.sh ]; then
  # shellcheck disable=SC1091
  . /opt/toolchain/env.sh
fi

if [ ! -f "${config}" ]; then
  echo "user-services: missing ${config}" >&2
  exit 1
fi

exec supervisord -c "${config}"